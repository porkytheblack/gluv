{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@gluv/core": ["../../packages/core/src/index.ts"],
      "@gluv/core/*": ["../../packages/core/src/*"],
      "@gluv/react": ["../../packages/react/src/index.ts"],
      "@gluv/react/*": ["../../packages/react/src/*"],
      "@gluv/adapters": ["../../packages/adapters/src/index.ts"],
      "@gluv/adapters/*": ["../../packages/adapters/src/*"]
    },
    "baseUrl": "."
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "../../packages/*/src/**/*.ts", "../../packages/*/src/**/*.tsx"],
  "exclude": ["node_modules"]
}
